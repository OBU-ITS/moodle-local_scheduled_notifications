{{!
    @template local_scheduled_notifications/notification_summary

    Notification summary card shown in admin listing
}}
<a class="notification-summary" href="{{link}}" title="{{#str}} general_edit_text, local_scheduled_notifications {{/str}} {{name}}">
    <h4>{{name}}</h4>
    <p class="notification-summary_dates">
        <strong>
            {{#userdate}} {{from}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}
            -
        {{#userdate}} {{to}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}
        </strong>
    </p>
    <p class="notification-summary_info">
        <strong>{{#str}} created_by_text, local_scheduled_notifications {{/str}}:</strong> {{createdby}} <br />
 {{#hasupdated}}
 <strong>{{#str}} updated_by_text, local_scheduled_notifications {{/str}}:</strong> {{updatedby}} <br />
 <strong>{{#str}} updated_on_text, local_scheduled_notifications {{/str}}:</strong> {{#userdate}} {{updatedon}}, {{#str}} strftimedate, core_langconfig {{/str}} {{/userdate}}
{{/hasupdated}}
{{^hasupdated}}
<strong>{{#str}} created_on_text, local_scheduled_notifications {{/str}}:</strong> {{#userdate}} {{updatedon}}, {{#str}} strftimedate, core_langconfig {{/str}} {{/userdate}}
{{/hasupdated}}
    </p>
</a>
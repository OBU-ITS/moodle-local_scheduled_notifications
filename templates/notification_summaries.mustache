{{!
    @template local_scheduled_notifications/notification_summaries

    List of notification summaries
}}
{{#hascurrent}}
    <h3>{{#str}} current_notifications_heading, local_scheduled_notifications {{/str}}</h3>
    {{#current}}
        {{> local_scheduled_notifications/notification_summary }}
    {{/current}}
{{/hascurrent}}

{{#hasfuture}}
    <h3>{{#str}} future_notifications_heading, local_scheduled_notifications {{/str}}</h3>
    {{#future}}
        {{> local_scheduled_notifications/notification_summary }}
    {{/future}}
{{/hasfuture}}

{{#haspast}}
    <h3>{{#str}} past_notifications_heading, local_scheduled_notifications {{/str}}</h3>
    {{#past}}
        {{> local_scheduled_notifications/notification_summary }}
    {{/past}}
{{/haspast}}